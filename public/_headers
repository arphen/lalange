/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# The service worker URL is stable and must be revalidated on every update check.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Do not apply immutable wildcard rules to assets. Cloudflare Pages can serve
# the SPA fallback for a missing asset during deployment propagation, and that
# HTML response must never be pinned under a JavaScript or stylesheet URL.

# Don't cache HTML (for updates)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Application-state routes are crawlable so search engines can see noindex.
/reader/*
  X-Robots-Tag: noindex, nofollow

/settings/*
  X-Robots-Tag: noindex, nofollow

/settings
  X-Robots-Tag: noindex, nofollow

/sync
  X-Robots-Tag: noindex, nofollow

/exchange
  X-Robots-Tag: noindex, nofollow

/exchange/*
  X-Robots-Tag: noindex, nofollow

/EXCHANGE
  X-Robots-Tag: noindex, nofollow

/EXCHANGE/*
  X-Robots-Tag: noindex, nofollow

/library
  X-Robots-Tag: noindex, nofollow

/app-shell
  X-Robots-Tag: noindex, nofollow

/app-shell.html
  X-Robots-Tag: noindex, nofollow

/
  Cache-Control: no-cache, no-store, must-revalidate
