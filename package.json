{
  "name": "xyz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run prepare:ocr-assets",
    "dev:https": "VITE_HTTPS=1 vite",
    "predev:https": "npm run prepare:ocr-assets",
    "prebuild": "npm run prepare:ocr-assets",
    "prepare:ocr-assets": "node scripts/prepare_ocr_assets.mjs",
    "build": "tsc -b && node scripts/generate-sitemap.mjs && vite build && node scripts/prerender-public-routes.mjs && node scripts/validate-prerendered-routes.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --exclude '**/*.integration.test.ts'",
    "test:epub-corpus": "RUN_EPUB_CORPUS=1 vitest run src/core/ingest/structure.corpus.integration.test.ts",
    "gutenberg:corpus": "node scripts/download_gutenberg_corpus.mjs --run",
    "test:integration": "vitest run integration",
    "coverage": "vitest run --coverage",
    "og:image": "node scripts/generate-og-image.mjs",
    "deploy": "npm run build && wrangler pages deploy dist",
    "prepare": "husky",
    "screenshot": "playwright test"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@mlc-ai/web-llm": "file:./packages/web-llm",
    "@mlc-ai/web-runtime": "^0.23.0-dev1",
    "@tesseract.js-data/eng": "1.0.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "core-js": "^3.49.0",
    "dexie": "^4.2.1",
    "epubjs": "^0.3.93",
    "framer-motion": "^12.23.26",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.562.0",
    "onnxruntime-web": "1.18.0",
    "p-queue": "^9.0.1",
    "pdfjs-dist": "5.4.624",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2",
    "simple-peer": "^9.11.1",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.28",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "puppeteer": "^25.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "wrangler": "^4.54.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.3"
    },
    "epubjs": {
      "@xmldom/xmldom": "0.8.13"
    },
    "fix": {
      "underscore": "1.13.8",
      "underscore.string": "3.3.6"
    },
    "miniflare": {
      "undici": "7.29.0"
    },
    "rxdb": {
      "ajv": "8.20.0",
      "ws": "8.21.2"
    }
  }
}
